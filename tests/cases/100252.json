            "user": "NT AUTHORITY\\\\SYSTEM",
            "integrityLevel": "System",
            "processId": "1234",
            "parentProcessGuid": "{11111111-5eb6-6ac8-a900-000000002800}",
            "parentImage": "C:\\\\Windows\\\\System32\\\\services.exe"
          }
        }
      },
      "expect": {
        "id": "61619",
        "level": 0
      }
    }
  ]
}
