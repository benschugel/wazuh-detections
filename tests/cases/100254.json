{
  "rule": "100254",
  "title": "Intel DSA tray opening its support page through explorer (level 3)",
  "cases": [
    {
      "name": "DSATray opens intel.com through explorer",
      "location": "guard",
      "event": {
        "win": {
          "system": {
            "providerName": "Microsoft-Windows-Sysmon",
            "channel": "Microsoft-Windows-Sysmon/Operational",
            "severityValue": "INFORMATION",
            "eventID": "1"
          },
          "eventdata": {
            "image": "C:\\\\Windows\\\\SysWOW64\\\\explorer.exe",
            "originalFileName": "EXPLORER.EXE",
            "commandLine": "\\\"C:\\\\Windows\\\\System32\\\\explorer.exe\\\" https://www.intel.com/content/www/us/en/support/intel-driver-support-assistant.html?updatenow&amp;fromnotif",
            "user": "hx-102\\\\user",
            "integrityLevel": "System",
            "processId": "1234",
            "parentProcessGuid": "{11111111-5eb6-6ac8-a900-000000002800}",
            "parentImage": "C:\\\\Program Files (x86)\\\\Intel\\\\Driver and Support Assistant\\\\x86\\\\DSATray.exe"
          }
        }
      },
      "expect": {
        "id": "100254",
        "level": 3
      }
    },
    {
      "name": "DSATray opening a non-Intel URL is NOT lowered",
      "location": "guard",
      "event": {
        "win": {
          "system": {
            "providerName": "Microsoft-Windows-Sysmon",
            "channel": "Microsoft-Windows-Sysmon/Operational",
            "severityValue": "INFORMATION",
            "eventID": "1"
          },
          "eventdata": {
            "image": "C:\\\\Windows\\\\SysWOW64\\\\explorer.exe",
            "originalFileName": "EXPLORER.EXE",
            "commandLine": "\\\"C:\\\\Windows\\\\System32\\\\explorer.exe\\\" https://evil.example/",
            "user": "hx-102\\\\user",
            "integrityLevel": "System",
            "processId": "1234",
            "parentProcessGuid": "{11111111-5eb6-6ac8-a900-000000002800}",
            "parentImage": "C:\\\\Program Files (x86)\\\\Intel\\\\Driver and Support Assistant\\\\x86\\\\DSATray.exe"
          }
        }
      },
      "expect": {
        "id": "61640",
        "level": 12
      }
    }
  ]
}
