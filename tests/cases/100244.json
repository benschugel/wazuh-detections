{
  "rule": "100244",
  "title": "Installers writing their Uninstall registry entry (level 3)",
  "cases": [
    {
      "name": "RustDesk installer EstimatedSize (SYSTEM via cmd)",
      "location": "guard",
      "event": {
        "win": {
          "system": {
            "providerName": "Microsoft-Windows-Sysmon",
            "eventID": "1",
            "channel": "Microsoft-Windows-Sysmon/Operational",
            "severityValue": "INFORMATION"
          },
          "eventdata": {
            "image": "C:\\\\Windows\\\\System32\\\\reg.exe",
            "originalFileName": "reg.exe",
            "commandLine": "reg  add HKEY_LOCAL_MACHINE\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Uninstall\\\\RustDesk /f /v EstimatedSize /t REG_DWORD /d 76196",
            "parentImage": "C:\\\\Windows\\\\System32\\\\cmd.exe",
            "user": "NT AUTHORITY\\\\SYSTEM",
            "integrityLevel": "System",
            "processId": "1234"
          }
        }
      },
      "expect": {
        "id": "100244",
        "level": 3
      }
    },
