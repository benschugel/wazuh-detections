          },
          "eventdata": {
            "image": "C:\\\\Windows\\\\System32\\\\reg.exe",
            "originalFileName": "reg.exe",
            "commandLine": "C:\\\\WINDOWS\\\\System32\\\\reg.exe add HKCU\\\\Software\\\\Classes\\\\Discord\\\\shell\\\\open\\\\command /ve /d \\\"\\\\\\\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Discord\\\\app-1.0.9261\\\\Discord.exe\\\\\\\" --url -- \\\\\\\"%1\\\\\\\"\\\" /f",
            "user": "hx-102\\\\user",
            "integrityLevel": "System",
            "processId": "1234",
            "parentProcessGuid": "{11111111-5eb6-6ac8-a900-000000002800}",
            "parentImage": "C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Discord\\\\app-1.0.9261\\\\Discord.exe"
          }
        }
      },
      "expect": {
        "id": "100255",
        "level": 3
      }
    },
