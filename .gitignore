# Replay inputs copied out of a live manager hold real host data.
alerts*.json
alerts*.json.gz

# deploy.sh copies the manager's current files here before replacing them.
backups/

# Editor and interpreter leftovers
__pycache__/
*.pyc
*.bak
*.log

# Secrets, env files and local config: never commit
.env
.env.*
*.env
!.env.example
!*.env.example
secrets.yml
secrets.yaml
*.pem
*.key
*.p12
*.pfx
*.local
*.local.*
